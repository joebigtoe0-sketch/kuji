# KUJI — the zero-edge capsule machine
# Copy to .env. With everything unset you get PAPER MODE on port 8630:
# real market data, real cryptography, fake money.
PORT=8630

# ---------- mode ----------
# Leave LIVE_MODE unset and flip live from /admin instead — it applies
# immediately, survives restarts, and can be flipped back.
# LIVE_MODE=true          # real chain: buys, payments, refunds, prizes
# DEVNET=true             # live mode against devnet (dev-api.collectorcrypt.com + devnet RPC)
# --- Helius: ONE variable covers both. Set RPC_URL to your Helius endpoint:
#       RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
#     (devnet: https://devnet.helius-rpc.com/?api-key=YOUR_KEY)
#     Then leave DAS_URL blank — Helius serves DAS on the same endpoint and
#     the app detects it. Use a Helius project SEPARATE from any trading bot:
#     this machine polls constantly and would eat a shared credit budget.
#
# RPC_URL=                # REQUIRED in live mode. Public RPCs rate-limit getBlock
#                         # (every capsule open needs one) and refuse
#                         # getProgramAccounts (holder snapshots).
# DAS_URL=                # Only needed if your RPC is NOT Helius. "DAS" = Digital
#                         # Asset Standard: the index that can read COMPRESSED NFTs,
#                         # which have no on-chain account at all (they are leaves in
#                         # a merkle tree). Without it a compressed card can be bought
#                         # but never verified or shipped as a prize, so live mode
#                         # refuses to switch on until DAS is reachable.
# WALLET_SECRET=          # base58 or JSON byte array. Unset -> generated to data/wallet.json,
#                         # which MUST then live on a persistent volume (see README).
# ADMIN_KEY=              # guards /admin and /api/admin/*. Live mode REFUSES TO START
#                         # without it — no key means no kill switch.
# HOST=                   # bind address; auto 0.0.0.0 when deployed, 127.0.0.1 locally

# ---------- token / ANSEM ----------
# Both the token CA and the X link are settable from /admin at runtime.
# TOKEN_MINT=             # our ClawPump token -> real holder raffles
# X_URL=                  # X profile, shown in the header and footer
# ANSEM_MINT=             # $ANSEM mint -> holder-raffle weight boost
# ANSEM_BOOST=1.5         # entry multiplier for ANSEM holders
# ANSEM_MIN=10            # min ANSEM balance to qualify for the boost
# ANSEM_PER_USD=0         # accept ANSEM for tickets at this rate (0 = USDC only)
# EXCLUDE_WALLETS=        # comma-separated: AMM pools, deployer — never win their own raffle

# ---------- sniper ----------
PAPER_BUDGET=500
MIN_EDGE=0.15            # buy only if price <= comp * (1 - MIN_EDGE)
MAX_EDGE=0.45            # above this = comp error until a human agrees (never raffles or racks either)
MAX_BUYS_PER_SWEEP=3
MAX_PER_CARD_FRAC=0.25
# LIVE_MAX_CARD_USD=50   # hard per-card cap for REAL buys — raise only deliberately
COMP_HAIRCUT=0.9         # comp = min(2nd-lowest, median) same-card listing * this
MIN_COMPS=3              # need at least this many fresh same-card listings to trust a comp
PRICE_MIN=20
PRICE_MAX=400
SCAN_PAGES=30            # newest-first pages per sweep (100 cards/page)
SCAN_EVERY_MIN=10
CATEGORIES=Pokemon,One Piece,Magic The Gathering,Lorcana,Dragon Ball,Riftbound

# Bootstrap: at launch inventory beats edge, so cards under BOOTSTRAP_MAX_CARD_USD
# clear a relaxed bar. Toggle it off from /admin once the vault is stocked.
BOOTSTRAP=true
BOOTSTRAP_MIN_EDGE=0.05
BOOTSTRAP_MAX_CARD_USD=40

# ---------- capsule machines ----------
CAPSULE_USD=1            # STARTING price; the live price floats with the rack
MAX_CARD_SHARE=0.08      # no single card may exceed this share of a rack — this is
                         # the variance knob, not an edge knob (see capsules.ts)
CARDS_PER_MACHINE=8      # basket size; diversification is free variance reduction
MIN_CARDS_PER_MACHINE=3  # below this it waits for stock rather than build a coin-flip
MACHINE_MAX_CARD_USD=150 # bigger cards go to raffles instead

# ---------- raffles ----------
TICKETS_MIN=10
TICKETS_MAX=25
RAFFLE_FILL_HOURS=48     # fill-or-refund window
RESOLVE_DELAY_MIN=30
HOLDER_RAFFLE_SHARE=0.5  # this share of realized profit funds FREE holder raffles
MAX_OPEN_RAFFLES=2
GRADE_AFTER_H=24         # how long before an edge is graded taken / still-listed

# ---------- local demo / timers ----------
SIM_BUYERS=true          # paper only: simulated buyers and a two-sided ticket market
SIM_BUY_EVERY_SEC=45
# PAY_WATCH_EVERY_SEC=20 # live: payment poll interval
