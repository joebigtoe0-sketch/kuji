# THE CARD MACHINE (paper mode) — all local, no real money
PORT=8630
# paper bankroll (USDC) the sniper starts with
PAPER_BUDGET=500
# sniper rules
MIN_EDGE=0.15            # buy only if price <= comp * (1 - MIN_EDGE)
COMP_HAIRCUT=0.9         # comp = 2nd-lowest same-card listing * this
MIN_COMPS=3              # need at least this many same-card listings to trust a comp
PRICE_MIN=20
PRICE_MAX=400
SCAN_PAGES=30            # newest-first pages per sweep (100 cards/page)
SCAN_EVERY_MIN=10
CATEGORIES=Pokemon,One Piece,Magic The Gathering,Lorcana,Dragon Ball,Riftbound
# raffle sizing
TICKETS_MIN=10
TICKETS_MAX=25
RAFFLE_FILL_HOURS=48     # fill-or-refund window
# profit split: this share of realized sniping profit funds FREE holder raffles
HOLDER_RAFFLE_SHARE=0.5
